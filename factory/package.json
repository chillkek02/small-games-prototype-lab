{
  "name": "gutpopper-game-factory",
  "productName": "Gutpopper Game Factory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "AI browser-game studio, Poki opportunity scout, desktop factory and private phone remote for Gutpopper Games.",
  "author": "Gutpopper Games",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "check": "node --check server.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check lib/qa.js && node --check lib/runner.js && node --check lib/opportunity.js && node --check lib/new-game.js && node --check public/app.js && node --check public/sw.js",
    "package:win": "npm run check && electron-builder --win dir --x64",
    "make:win": "npm run check && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "phaser4": "npm:phaser@4.2.1",
    "playwright": "1.62.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "com.gutpopper.gamefactory",
    "productName": "Gutpopper Game Factory",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Gutpopper-Game-Factory-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gutpopper Game Factory",
      "runAfterFinish": true
    }
  }
}
